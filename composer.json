{
	"name": "flarum-lang/arabic",
	"description": "Arabic Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/arabic",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/arabic/issues",
		"forum": "https://discuss.flarum.org/d/40169",
		"source": "https://github.com/flarum-lang/arabic"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Arabic",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "ar",
			"title": "العربية",
			"direction": "rtl"
		}
	}
}
